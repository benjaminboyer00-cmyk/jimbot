# Copier en .env pour un usage local, ou déclarer ces valeurs dans
# GitHub → Settings → Secrets and variables → Actions.

# --- Secrets (onglet « Secrets ») ---

# Webhook du salon Discord où publier alertes et rapports.
# Discord → Paramètres du salon → Intégrations → Webhooks → Nouveau webhook.
DISCORD_WEBHOOK_URL=

# Rôle mentionné sur les signaux à très forte conviction (facultatif).
# Activer le mode développeur Discord, clic droit sur le rôle → Copier l'identifiant.
DISCORD_ROLE_ID=

# Clé API Anthropic pour la rédaction des analyses (facultatif).
# Sans elle, le moteur de gabarits déterministe prend le relais : aucune
# fonctionnalité n'est perdue, seul le style du texte change.
ANTHROPIC_API_KEY=

# --- Réglages (onglet « Variables ») ---

# Seuil d'émission d'un signal, sur 100. En dessous, l'actif reste neutre.
JIMBOT_SIGNAL_THRESHOLD=58
# Seuil de publication sur Discord. Toujours >= au seuil d'émission.
JIMBOT_ALERT_THRESHOLD=68
# Seuil au-delà duquel le rôle Discord est mentionné.
JIMBOT_PING_THRESHOLD=80
# Capital de départ du portefeuille papier.
JIMBOT_PAPER_CAPITAL=10000
# Délai minimal, en minutes, entre deux alertes sur le même actif et le même sens.
JIMBOT_ALERT_COOLDOWN_MIN=180
# Modèle utilisé pour la rédaction.
JIMBOT_LLM_MODEL=claude-opus-5
