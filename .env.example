# Copier en .env pour un usage local, ou déclarer ces valeurs dans
# GitHub → Settings → Secrets and variables → Actions.

# --- Secrets (onglet « Secrets ») ---

# Webhook du salon Discord où publier alertes et rapports.
# Discord → Paramètres du salon → Intégrations → Webhooks → Nouveau webhook.
DISCORD_WEBHOOK_URL=

# Rôle mentionné sur les signaux à très forte conviction (facultatif).
# Activer le mode développeur Discord, clic droit sur le rôle → Copier l'identifiant.
DISCORD_ROLE_ID=

# Clé API Anthropic pour la rédaction des analyses (facultatif).
# Sans elle, le moteur de gabarits déterministe prend le relais : aucune
# fonctionnalité n'est perdue, seul le style du texte change.
ANTHROPIC_API_KEY=

# --- Réglages (onglet « Variables ») ---

# Seuil d'émission d'un signal, sur 100. En dessous, l'actif reste neutre.
JIMBOT_SIGNAL_THRESHOLD=58
# Seuil de publication sur Discord. Toujours >= au seuil d'émission.
JIMBOT_ALERT_THRESHOLD=68
# Seuil au-delà duquel le rôle Discord est mentionné.
JIMBOT_PING_THRESHOLD=80
# Capital de départ du portefeuille papier.
JIMBOT_PAPER_CAPITAL=10000
# Délai minimal, en minutes, entre deux alertes sur le même actif et le même sens.
JIMBOT_ALERT_COOLDOWN_MIN=180
# Modèle utilisé pour la rédaction.
JIMBOT_LLM_MODEL=claude-opus-5

# --- Raccordement courtier (facultatif) --------------------------------------
# Deux implémentations, même interface.
#
#   capital  Capital.com. Environnement de démonstration gratuit, cote forex,
#            or, indices et cryptos en CFD, et son application mobile montre les
#            positions. C'est le défaut.
#   metaapi  Pont vers un compte MetaTrader. Facture la connexion elle-même,
#            indépendamment du compte MT5 : sans solde chez MetaApi, le compte
#            reste indéfiniment DISCONNECTED, même en démonstration.
JIMBOT_BROKER_TYPE=capital

# Capital.com — clé créée dans Réglages > Intégrations API, A2F active.
# CAPITAL_PASSWORD est le mot de passe de la CLÉ, pas celui du compte.
CAPITAL_API_KEY=
CAPITAL_IDENTIFIER=
CAPITAL_PASSWORD=
CAPITAL_DEMO=1

# --- Raccordement MetaTrader (facultatif) ------------------------------------
# L'application MetaTrader mobile n'exécute aucun code et GitHub Actions ne peut
# pas faire tourner un terminal : MetaApi tient la connexion au compte et
# l'expose en REST. Le moteur y poste ses ordres, l'app mobile les affiche.
#
# Interrupteur. Sans lui, rien ne part, même si un jeton est présent.
# Multiplicateur du risque par trade. Vaut 1 par défaut, plafonné à 10.
#
# Sur un compte de 50 EUR, le moteur risque 0,05 EUR par trade — une taille
# qu'aucun courtier n'accepte. Le monter rend les ordres passables ; cela ne
# rend pas la stratégie meilleure, seulement l'encaissement plus rapide, dans
# les deux sens. Mesuré sur 50 EUR : à 1, cinq instruments sur quinze passent ;
# à 5, huit sur quinze, pour 0,44 % du compte par trade.
JIMBOT_RISK_MULT=1

JIMBOT_BROKER=0
# Jeton et compte, obtenus sur app.metaapi.cloud
METAAPI_TOKEN=
METAAPI_ACCOUNT_ID=
# Région du point d'entrée : new-york, london, singapore...
METAAPI_REGION=new-york
# Positions simultanées ouvertes par le moteur sur le compte courtier.
JIMBOT_BROKER_MAX_POSITIONS=5
# Autoriser un compte RÉEL. Laissé vide, le moteur refuse tout compte dont le
# courtier ne dit pas qu'il est de démonstration. Ne posez ceci qu'en sachant
# exactement ce que vous faites.
JIMBOT_BROKER_ALLOW_LIVE=
